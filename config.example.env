# Copy to config.env (never commit it) and fill in. TESTNET-10 ONLY.

# Where the run writes logs, control.json and the STOP file
RUN_DIR=/path/to/run-dir

# Kaspa SDK 2.1.0 for Node: path to kaspa-wasm32-sdk/nodejs/kaspa/kaspa.js
KASPA_SDK=/path/to/kaspa-wasm32-sdk/nodejs/kaspa/kaspa.js
# Path to the websocket package (only used by wminer.mjs)
WS_MOD=/path/to/node_modules/websocket/index.js

# Lane state file (outpoints per lane). Keep it local, mode 600, never in git.
TIPS_FILE=/path/to/private/lane-tips.json

# Nodes as name=host, comma separated. Public TN10 wRPC hosts or your own node.
# A full ws:// or wss:// URL is also accepted for your own node. Never commit your own node's address.
NODES=muon=muon-10.kaspa.blue,electron=electron-10.kaspa.blue,neutrino=neutrino-10.kaspa.stream,boson=boson-10.kaspa.red,vector=vector-10.kaspa.green

# Run window (UTC). The sender also reads start_utc from control.json.
START_UTC=2026-01-01T14:00:00Z
HARD_STOP_UTC=2026-01-01T16:30:00Z
# Seconds the fee reader may run past the hard stop (keep it 0 or small)
FEE_READS_TAIL_S=0

# Sender limits
CAP_TX_S=300
FEE_SOMPI_PER_GRAM=400

# wRPC miner hosts (fallback miner), comma separated
MINER_HOSTS=muon-10.kaspa.blue,electron-10.kaspa.blue
